generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  ADMIN
  UNIVERSITY
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
  DELETED
}

enum SessionPlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN
}

enum SecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  SESSION_CREATED
  SESSION_CREATION_FAILED
  SESSION_REVOKED
  OTHER_SESSIONS_REVOKED
  SUSPICIOUS_ACTIVITY_DETECTED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
}

enum SecurityEventReason {
  INVALID_CREDENTIALS
  ACTIVE_SESSION_LIMIT_REACHED
  LOGOUT
  SESSION_MANAGEMENT
}

enum SecurityRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum SecurityRiskSignal {
  NEW_DEVICE
  NEW_COUNTRY
  EXCESSIVE_LOGIN_FAILURES
  MANY_NEW_SESSIONS
  REFRESH_TOKEN_REUSE
}

enum NotificationType {
  NEW_SESSION
  SUSPICIOUS_ACTIVITY
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  // core
  id            String  @id @default(cuid())
  username      String  @unique
  email         String  @unique
  emailVerified Boolean @default(false)
  passwordHash  String
  universityId  String

  // service
  role   UserRole   @default(MEMBER)
  status UserStatus @default(PENDING)

  // security
  lastLoginAt             DateTime?
  loginAttempts           Int       @default(0)
  lockoutUntil            DateTime?
  verificationEmailSentAt DateTime?

  // tokens
  hashedVerificationToken  String?
  verificationTokenExpires DateTime?

  // timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // foreign keys
  university University @relation(fields: [universityId], references: [id])

  // relations
  sessions               Session[]
  securityEvents         SecurityEvent[]
  notificationDeliveries NotificationDelivery[]
  passwordResetTokens    PasswordResetToken[]
}

model PasswordResetToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordResetRateLimit {
  key         String   @id
  count       Int
  windowEndAt DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowEndAt])
}

model University {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  users          User[]
  allowedDomains AllowedDomain[]
}

model AllowedDomain {
  id           String     @id @default(cuid())
  domain       String     @unique
  active       Boolean    @default(true)
  universityId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  university   University @relation(fields: [universityId], references: [id])
}

model Session {
  // core
  id                 String @id @default(cuid())
  userId             String
  hashedRefreshToken String

  // userInfo
  ipAddress             String?
  userAgent             String?
  sessionName           String?
  deviceModelIdentifier String?
  deviceModel           String?
  platform              SessionPlatform @default(UNKNOWN)
  osVersion             String?
  appVersion            String?
  locationCountryCode   String?
  locationCity          String?

  // timestamps
  expiresAt    DateTime
  revokedAt    DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  actorSecurityEvents    SecurityEvent[]        @relation("SecurityEventActorSession")
  subjectSecurityEvents  SecurityEvent[]        @relation("SecurityEventSubjectSession")
  notificationDeliveries NotificationDelivery[]

  @@index([userId, revokedAt])
  @@index([userId, lastActiveAt])
  @@index([expiresAt])
}

model NotificationDelivery {
  id                 String                     @id @default(cuid())
  idempotencyKey     String?                    @unique
  type               NotificationType
  channel            NotificationChannel
  status             NotificationDeliveryStatus @default(PENDING)
  userId             String?
  sessionId          String?
  recipient          String
  providerMessageId  String?
  failureCode        String?
  attemptedAt        DateTime?
  sentAt             DateTime?
  retentionExpiresAt DateTime
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([retentionExpiresAt])
}

model SecurityEvent {
  id               String               @id @default(cuid())
  type             SecurityEventType
  reason           SecurityEventReason?
  userId           String?
  actorSessionId   String?
  subjectSessionId String?
  riskLevel        SecurityRiskLevel?
  riskSignals      SecurityRiskSignal[] @default([])

  ipAddress             String?
  userAgent             String?
  deviceModelIdentifier String?
  deviceModel           String?
  platform              SessionPlatform?
  osVersion             String?
  appVersion            String?
  locationCountryCode   String?
  locationCity          String?

  affectedSessionCount Int?
  occurredAt           DateTime @default(now())
  retentionExpiresAt   DateTime

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorSession   Session? @relation("SecurityEventActorSession", fields: [actorSessionId], references: [id], onDelete: SetNull)
  subjectSession Session? @relation("SecurityEventSubjectSession", fields: [subjectSessionId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@index([actorSessionId])
  @@index([subjectSessionId])
  @@index([retentionExpiresAt])
}
